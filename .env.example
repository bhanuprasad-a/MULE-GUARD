APP_NAME=MuleGuard
ENVIRONMENT=development

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=muleguard_bank
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_password_here

# Biometric Master Key (AES-256-GCM 32-byte secret)
# MANDATORY in production; fallback available ONLY in development
MULEGUARD_BIO_KEY=your_32_byte_secret_key_here!

# CORS Configuration (comma-separated origins)
# In production, must be explicit institutional origins
ALLOWED_ORIGINS=https://guard.muleguard.bank,https://compliance.muleguard.bank,https://admin.muleguard.bank
